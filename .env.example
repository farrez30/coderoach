# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Postgres connection string. DATABASE_URL is accepted too.
# On Railway, the web service reads it from the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URI=postgresql://user:password@host/db?sslmode=require

# Media uploads are stored on disk in ./media. On Railway, a volume is mounted at /app/media.

# npm run seed clears and rewrites most collections. It only runs with this set, on a local database.
SEED_TARGET=local

# Public site URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Branding (also editable in admin → Site Settings — these are first-boot fallbacks)
NEXT_PUBLIC_SITE_NAME=Studio

# Email — Resend (https://resend.com)
# Free tier: 100/day. Used for contact form notifications + admin emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@example.com
RESEND_TO_EMAIL=hello@example.com

# Analytics — site-wide, loaded only when set. OpsScore funnel events go to both.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Cloudflare Turnstile. Both keys come from the Cloudflare dashboard (Turnstile → Add site).
# While they are empty the OpsScore gate and the brief form work without the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
